<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/bw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bovi_widget_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="14dp"
  android:paddingEnd="14dp">
  <TextView
    android:id="@+id/bw_glance_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="BOVI"
    android:textColor="#818CF8"
    android:textSize="11sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:letterSpacing="0.08" />
  <TextView
    android:id="@+id/bw_glance_text"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="Open BOVI to load"
    android:textColor="#F3F4F6"
    android:textSize="15sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_weight="1"
    android:layout_marginStart="10dp" />
  <TextView
    android:id="@+id/bw_glance_meta"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text=""
    android:textColor="#9CA3AF"
    android:textSize="12sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_marginStart="8dp" />
</LinearLayout>
