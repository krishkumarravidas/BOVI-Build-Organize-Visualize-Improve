<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/bw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bovi_widget_bg"
  android:orientation="vertical"
  android:padding="12dp">
  
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
    android:id="@+id/bw_title"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:text="BOVI"
    android:textColor="#BDBDBD"
    android:textSize="11sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:letterSpacing="0.08" />
    <TextView
    android:id="@+id/bw_header_meta"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text=""
    android:textColor="#9B9B9B"
    android:textSize="11sp"
    android:maxLines="1"
    android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal">
    <TextView
    android:id="@+id/bw_st_total"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="—"
    android:textColor="#F2F2F2"
    android:textSize="28sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end" />
    <TextView
    android:id="@+id/bw_st_limit"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text=""
    android:textColor="#9B9B9B"
    android:textSize="12sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_weight="1"
    android:layout_marginStart="8dp" />
  </LinearLayout>
  <ProgressBar
    android:id="@+id/bw_st_progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:indeterminate="false"
    android:max="100"
    android:progress="0"
    android:progressDrawable="@drawable/bw_progress" android:layout_marginTop="4dp" />
  <TextView
    android:id="@+id/bw_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text=""
    android:textColor="#9B9B9B"
    android:textSize="13sp"
    android:maxLines="3"
    android:ellipsize="end"
    android:layout_marginTop="6dp"
    android:visibility="gone" />
  
  <LinearLayout
    android:id="@+id/bw_rows"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="vertical" />
</LinearLayout>
