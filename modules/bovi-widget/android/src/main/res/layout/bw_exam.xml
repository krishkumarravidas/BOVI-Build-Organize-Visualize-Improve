<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/bw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bovi_widget_bg"
  android:orientation="vertical"
  android:padding="12dp">
  <TextView
    android:id="@+id/bw_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="NEXT EXAM"
    android:textColor="#C4B8FC"
    android:textSize="11sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:letterSpacing="0.08" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal">
    <TextView
    android:id="@+id/bw_exam_days"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="—"
    android:textColor="#EEEDF2"
    android:textSize="38sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:includeFontPadding="false" />
    <TextView
    android:id="@+id/bw_exam_unit"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text=""
    android:textColor="#9A97A5"
    android:textSize="14sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_marginStart="4dp" />
  </LinearLayout>
  <TextView
    android:id="@+id/bw_exam_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Open BOVI to load exams"
    android:textColor="#EEEDF2"
    android:textSize="14sp"
    android:textStyle="bold"
    android:maxLines="2"
    android:ellipsize="end" />
  <TextView
    android:id="@+id/bw_exam_when"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text=""
    android:textColor="#9A97A5"
    android:textSize="12sp"
    android:maxLines="1"
    android:ellipsize="end" />
  <ProgressBar
    android:id="@+id/bw_exam_progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:indeterminate="false"
    android:max="100"
    android:progress="0"
    android:progressDrawable="@drawable/bw_progress" android:layout_marginTop="6dp" />
  <TextView
    android:id="@+id/bw_exam_topics"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text=""
    android:textColor="#9A97A5"
    android:textSize="11sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_marginTop="2dp" />
</LinearLayout>
